# Point this at your WPGraphQL endpoint. While it is unset the whole site
# renders from src/lib/wp/preview.ts, so the repo runs green before
# WordPress exists. Setting it switches every query over; nothing else changes.
WORDPRESS_GRAPHQL_ENDPOINT=

# Public site URL, used for canonicals, sitemap and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://techhowdaily.com

# Shared secret for POST /api/revalidate, called from a WP save_post hook.
REVALIDATE_SECRET=

# Optional. Name of the view-count field exposed by your views plugin
# (Post Views Counter exposes "views", WP-PostViews exposes "postViews").
# Unset or absent -> the trend ticker falls back to most-recent. See README.
WP_VIEWS_FIELD=
